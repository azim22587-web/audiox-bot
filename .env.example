# Telegram Bot Token (@BotFather orqali olinadi)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Admin Telegram ID(lar)i (masalan: 12345678,98765432)
ADMIN_IDS=12345678

# Bot yaratuvchisi va Reklama uchun Telegram Username (masalan: sizning_usernamingiz)
ADMIN_USERNAME=sizning_usernamingiz

# Ovozdan musiqa aniqlash uchun AudD API kaliti (ixtiyoriy, https://dashboard.audd.io)
AUDD_API_KEY=
